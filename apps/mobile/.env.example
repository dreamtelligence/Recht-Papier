EXPO_PUBLIC_SUPABASE_URL=
# Bevorzugt: neuer publishable key aus dem Supabase-Connect-Dialog.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur als Übergang für bestehende Projekte; niemals den service_role-Key eintragen.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Die Adresse der Legal-Engine steht hier bewusst NICHT mehr.
#
# Die App sprach die Engine früher direkt an. Das ging nur, solange die
# Engine ohne Authentifizierung antwortete — und genau das war das Problem:
# der veröffentlichte Endpunkt bediente jeden im Netz, inklusive der
# kostenpflichtigen LLM-Route. Jetzt verlangt sie einen Schlüssel, und ein
# Schlüssel in einem Mobile-Bundle ist keiner.
#
# Jede Rechtsabfrage läuft deshalb über unser Backend. Die App braucht
# dafür keine weitere Variable.
