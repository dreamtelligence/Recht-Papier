EXPO_PUBLIC_SUPABASE_URL=
# Bevorzugt: neuer publishable key aus dem Supabase-Connect-Dialog.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nur als Übergang für bestehende Projekte; niemals den service_role-Key eintragen.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Basis-URL der Legal-Engine (Jura). Optional: ohne diesen Wert bleiben nur die
# Nachschlage-Funktionen aus, die App selbst läuft vollständig.
#
# Nur für OEFFENTLICHES Recht — Gesetzestext und Urteile. Falltext geht niemals
# an diese Adresse, sondern ausschliesslich ueber eine Supabase Edge Function;
# siehe src/features/legal/client.ts.
#
# Lokal der Container (http://127.0.0.1:8000), sonst der EU-Deployment-Endpunkt.
# Die Modal-URL ist hier nur in der Entwicklung vertretbar.
EXPO_PUBLIC_LEGAL_ENGINE_URL=
