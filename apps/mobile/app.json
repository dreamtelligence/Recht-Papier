{
  "expo": {
    "name": "Recht & Papier",
    "slug": "recht-und-papier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.edwit.rechtundpapier",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "package": "de.edwit.rechtundpapier",
      "adaptiveIcon": {
        "backgroundColor": "#f4efe3",
        "foregroundImage": "./assets/brand/app-icon-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4efe3",
          "image": "./assets/brand/splash-paper.png",
          "imageWidth": 200,
          "resizeMode": "cover"
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Source Serif 4",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SourceSerif4-Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Source Serif 4 SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SourceSerif4-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/SourceSerif4-Regular.ttf",
              "./assets/fonts/SourceSerif4-SemiBold.ttf"
            ]
          }
        }
      ],
      "expo-sqlite"
    ],
    "scheme": "rechtundpapier",
    "backgroundColor": "#f4efe3"
  }
}
