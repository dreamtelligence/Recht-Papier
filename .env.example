# Vorlage. Kopieren nach .env und ausfüllen. .env gehört nie ins Repository.

# --- Lokaler Stack ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO

# --- Legal-Engine (Schritt 4) ---
# Basis-URL des Jura-Dienstes. Lokal der Container, sonst der EU-Deployment-Endpunkt.
LEGAL_ENGINE_URL=http://127.0.0.1:8000

# --- LLM ---
# Anbieter und EU-Datenresidenz sind noch nicht entschieden. Semantica notiert GPT-5.6,
# Jura nutzt real Gemini 2.5 Flash-Lite. Vor Festlegung an Primärquellen prüfen und einen
# Auftragsverarbeitungsvertrag mit EU-Verarbeitung sicherstellen.
LLM_PROVIDER=
LLM_API_KEY=

# --- Supabase ---
# Projekt "Recht und Papier", Region eu-central-1 (Frankfurt).
# Werte holst du mit: supabase projects api-keys --project-ref <ref>
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Wird beim Anlegen des Projekts gesetzt und nirgends sonst gespeichert.
SUPABASE_DB_PASSWORD=
