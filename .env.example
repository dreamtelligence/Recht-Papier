# Vorlage. Kopieren nach .env und ausfüllen. .env gehört nie ins Repository.

# --- Lokaler Stack ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO

# --- Legal-Engine ---
# Basis-URL des Jura-Dienstes. Lokal der Container, sonst der EU-Deployment-Endpunkt.
# Modal-URL nur zum Testen: https://aliundmaggy--legal-rag-fastapi-app.modal.run
LEGAL_ENGINE_URL=http://127.0.0.1:8000

# Zugangsschluessel der Engine. Ohne ihn verweigert der Dienst den Start —
# das ist Absicht: der Endpunkt stand vorher offen im Netz, inklusive der
# kostenpflichtigen LLM-Route.
#   openssl rand -hex 32
# Derselbe Wert muss in drei Umgebungen liegen: hier, im Modal-Secret
# legal-engine-key und in den Supabase-Secrets der Edge Functions.
LEGAL_ENGINE_API_KEY=

# --- LLM ---
# Anbieter und EU-Datenresidenz sind noch nicht entschieden. Semantica notiert GPT-5.6,
# Jura nutzt real Gemini 2.5 Flash-Lite. Vor Festlegung an Primärquellen prüfen und einen
# Auftragsverarbeitungsvertrag mit EU-Verarbeitung sicherstellen.
LLM_PROVIDER=
LLM_API_KEY=

# --- Supabase ---
# Projekt "Recht und Papier", Region eu-central-1 (Frankfurt).
# Werte holst du mit: supabase projects api-keys --project-ref <ref>
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Wird beim Anlegen des Projekts gesetzt und nirgends sonst gespeichert.
SUPABASE_DB_PASSWORD=

# --- Brevo SMTP (produktiver Mailversand fuer Anmeldecodes) ------------------
# Host, Benutzername und Schluessel stehen in Brevo unter "SMTP & API".
# Wichtig: der SMTP-Key, nicht der API-Key. Die beiden sind verschieden.
BREVO_SMTP_HOST=
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Absenderadresse. Muss auf einer in Brevo per SPF/DKIM authentifizierten Domain
# liegen, sonst landet der Anmeldecode im Spam oder wird abgewiesen.
BREVO_SENDER_EMAIL=

# Asynchronous case analysis; same callback secret in Supabase and Modal.
CASE_ANALYSIS_DISPATCH_URL=
CASE_ANALYSIS_CALLBACK_SECRET=
CASE_ANALYSIS_CALLBACK_URL=
